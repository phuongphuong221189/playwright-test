{
  "name": "test-anti",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:allure": "playwright test --reporter=allure-playwright",
    "test:ci": "playwright test --reporter=allure-playwright,line",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "npm run allure:generate && npm run allure:open",
    "report:serve": "npm run allure:serve"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.3.0",
    "typescript": "^6.0.3"
  }
}
